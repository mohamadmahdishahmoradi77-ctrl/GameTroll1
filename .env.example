# Database: choose ONE production mode. MySQL is recommended for cPanel; Render can keep PostgreSQL compatibility.
# MySQL (cPanel Application Manager / MySQL Wizard)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=game_troll
MYSQL_USER=game_troll
MYSQL_PASSWORD=CHANGE_ME
# Optional: use MYSQL_URL instead of the four variables above
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/game_troll

# Security
SESSION_SECRET=SET_A_LONG_RANDOM_SECRET
APP_URL=https://your-domain.example
PORT=3000
TRUST_PROXY=1

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Render/PostgreSQL compatibility (use this instead of MySQL variables on the legacy Render path)
ADMIN_PASSWORD=SET_A_STRONG_PASSWORD
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
